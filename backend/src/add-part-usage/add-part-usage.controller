import { Request, Response } from 'express'
import { Pool } from 'pg'
import 'dotenv/config'

const pool = new Pool({
  connectionString: process.env.DATABASE_URL,
})

export const createUsePart = async (req: Request, res: Response) => {
  try {
    const { part_id, job_id, quantity } = req.body

    if (!part_id || !job_id || !quantity) {
      return res.status(400).json({
        error: 'part_id, job_id, quantity required'
      })
    }

    const result = await pool.query(
      `INSERT INTO "use_part" (part_id, job_id, quantity)
       VALUES ('${part_id}', '${job_id}', ${quantity})
       RETURNING *`
    )

    res.json(result.rows)

  } catch (err: any) {
    res.status(500).json({ error: err.message })
  }
}
